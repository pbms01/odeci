# ==============================================================================
# ODECI Chat - Secrets para Streamlit Cloud
# ==============================================================================
# Este arquivo é um TEMPLATE. No Streamlit Cloud, configure os secrets
# diretamente no painel: App Settings > Secrets
#
# Formato no painel do Streamlit Cloud:
# Cole o conteúdo abaixo (sem os comentários) e preencha com suas chaves reais
# ==============================================================================

# Obrigatória - API da Anthropic (Claude)
ANTHROPIC_API_KEY = "sk-ant-api03-sua-chave-aqui"

# Para retrieval real (busca nos documentos)
VOYAGE_API_KEY = "pa-sua-chave-voyage-aqui"

# Opcional - melhora qualidade do reranking
COHERE_API_KEY = "sua-chave-cohere-aqui"

# Qdrant Cloud - Vector Store
QDRANT_URL = "https://seu-cluster.cloud.qdrant.io:6333"
QDRANT_API_KEY = "sua-chave-qdrant-aqui"
