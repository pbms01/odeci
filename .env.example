# ==============================================================================
# ODECI - Configuração de Ambiente
# ==============================================================================
# Copie este arquivo para .env e configure as variáveis:
#   cp .env.example .env
#
# MÍNIMO NECESSÁRIO:
#   - VOYAGE_API_KEY (embeddings)
#   - OPENAI_API_KEY ou ANTHROPIC_API_KEY (geração de respostas)
# ==============================================================================

# ========================================
# 1. EMBEDDINGS (OBRIGATÓRIO)
# ========================================

# Voyage AI - Modelo de embeddings principal
# Modelo: voyage-3-large (1024 dimensões)
# Obtenha em: https://dash.voyageai.com/
# Preço: ~$0.06 / 1M tokens
VOYAGE_API_KEY=your_voyage_api_key_here

# ========================================
# 2. GERAÇÃO DE RESPOSTAS (escolha um)
# ========================================

# OpenAI - GPT-4o-mini (recomendado por custo-benefício)
# Modelos disponíveis: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Obtenha em: https://platform.openai.com/api-keys
# Preço gpt-4o-mini: ~$0.15 input / $0.60 output por 1M tokens
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic - Claude (alternativa de alta qualidade)
# Modelos disponíveis: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# Obtenha em: https://console.anthropic.com/settings/keys
# Preço Claude Sonnet: ~$3 input / $15 output por 1M tokens
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# 3. RERANKING (OPCIONAL - melhora precisão)
# ========================================

# Cohere - Reranking de resultados de busca
# Modelo: rerank-english-v3.0
# Obtenha em: https://dashboard.cohere.com/api-keys
# Preço: ~$1 / 1K buscas
COHERE_API_KEY=your_cohere_api_key_here

# ========================================
# 4. VECTOR STORE
# ========================================

# Qdrant - Banco de dados vetorial
# Opções:
#   - Local: deixe QDRANT_URL vazio (usa arquivo local)
#   - Docker: QDRANT_URL=http://localhost:6333
#   - Cloud: QDRANT_URL=https://xxx.qdrant.io + QDRANT_API_KEY

# URL do servidor Qdrant
QDRANT_URL=

# API Key do Qdrant Cloud (apenas se usar cloud)
# Obtenha em: https://cloud.qdrant.io/
QDRANT_API_KEY=

# ========================================
# 5. CONFIGURAÇÕES GERAIS
# ========================================

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Diretório para dados persistentes
DATA_DIR=./data

# Ambiente: development, production
ENVIRONMENT=development

# ========================================
# RESUMO DE CUSTOS ESTIMADOS (por documento médio ~10k tokens)
# ========================================
# Embedding (Voyage):     ~$0.0006
# Geração (GPT-4o-mini):  ~$0.001
# Reranking (Cohere):     ~$0.001
# TOTAL:                  ~$0.003 por consulta
# ========================================
