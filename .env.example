# ODECI - Configuração de Ambiente
# Copie este arquivo para .env e configure as variáveis

# ========================================
# API Keys (obrigatórias para funcionalidade completa)
# ========================================

# Voyage AI - Embeddings especializados
# Obtenha em: https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Cohere - Reranking de resultados
# Obtenha em: https://cohere.com/
COHERE_API_KEY=your_cohere_api_key_here

# OpenAI - Geração de respostas
# Obtenha em: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) - Geração de respostas alternativa
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# Qdrant Vector Store
# ========================================

# URL do servidor Qdrant (deixe vazio para modo local)
QDRANT_URL=

# API Key do Qdrant Cloud (apenas se usar cloud)
QDRANT_API_KEY=your_qdrant_api_key_here

# ========================================
# Configurações Gerais
# ========================================

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Diretório de dados
DATA_DIR=./data

# Ambiente: development, production
ENVIRONMENT=development
